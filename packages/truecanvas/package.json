{
  "name": "truecanvas",
  "version": "0.6.0",
  "description": "Design with your real React components: a Figma-like canvas for Next.js and Vite where layers are your .tsx and agents edit through MCP.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "truecanvas": "dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/runtime/index.d.ts",
      "default": "./dist/runtime/index.js"
    },
    "./next": {
      "types": "./dist/next/index.d.ts",
      "default": "./dist/next/index.js"
    },
    "./vite": {
      "types": "./dist/vite/index.d.ts",
      "default": "./dist/vite/index.js"
    },
    "./share": {
      "types": "./dist/share/index.d.ts",
      "default": "./dist/share/index.js"
    },
    "./hub": {
      "types": "./dist/hub.d.ts",
      "default": "./dist/hub.js"
    },
    "./core": {
      "types": "./dist/core/index.d.ts",
      "default": "./dist/core/index.js"
    },
    "./host": {
      "types": "./dist/runtime/host.d.ts",
      "default": "./dist/runtime/host.js"
    },
    "./loader": "./dist/next/loader.cjs",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\" && tsup && vite build --config editor/vite.config.ts",
    "build:lib": "tsup",
    "build:editor": "vite build --config editor/vite.config.ts",
    "dev:editor": "vite --config editor/vite.config.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p editor/tsconfig.json",
    "test": "node --test",
    "prepublishOnly": "pnpm build && pnpm test",
    "prepack": "node ../../scripts/sync-readme.mjs"
  },
  "peerDependencies": {
    "next": ">=15.0",
    "react": ">=19",
    "vite": ">=5"
  },
  "peerDependenciesMeta": {
    "next": {
      "optional": true
    },
    "vite": {
      "optional": true
    }
  },
  "dependencies": {
    "@babel/parser": "^7.29.9",
    "@modelcontextprotocol/sdk": "^1.32.0",
    "launch-editor": "^2.14.1",
    "magic-string": "^1.4.2",
    "playwright-core": "^1.63.0",
    "prettier": "^3.9.9",
    "tinyglobby": "^0.2.17",
    "typescript": "^6.0.3",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@babel/types": "^7.29.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.1.1",
    "lucide-react": "^1.52.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tsup": "^8.5.1",
    "vite": "^8.3.2",
    "zustand": "^5.0.15"
  },
  "keywords": [
    "design",
    "canvas",
    "figma",
    "react",
    "nextjs",
    "vite",
    "tailwind",
    "mcp",
    "agents",
    "claude",
    "cursor",
    "design-system",
    "components"
  ],
  "engines": {
    "node": ">=22"
  },
  "homepage": "https://truecanvas.dev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Nathandona/truecanvas.git",
    "directory": "packages/truecanvas"
  },
  "bugs": {
    "url": "https://github.com/Nathandona/truecanvas/issues"
  },
  "publishConfig": {
    "access": "public"
  }
}
