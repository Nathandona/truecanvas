{
  "name": "truecanvas-desktop",
  "productName": "Truecanvas",
  "version": "0.6.7",
  "private": true,
  "description": "Truecanvas as a desktop app: the projects window in the tray, dev servers started on demand, notifications and automatic updates.",
  "homepage": "https://github.com/Nathandona/truecanvas",
  "author": {
    "name": "Nathan Donadey",
    "email": "nathan.donadey@epitech.eu"
  },
  "license": "MIT",
  "main": "dist/main.cjs",
  "desktopName": "truecanvas-desktop.desktop",
  "scripts": {
    "build": "node scripts/build.mjs",
    "stage-runtime": "node scripts/stage.mjs",
    "start": "pnpm build && electron .",
    "dist": "pnpm run build && pnpm run stage-runtime && electron-builder --linux --publish never",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "electron": "44.5.1",
    "electron-builder": "26.17.0",
    "electron-updater": "6.8.10",
    "esbuild": "^0.28.1",
    "truecanvas": "workspace:*",
    "typescript": "^6.0.3"
  }
}
